{
  "name": "astrafoundry-design",
  "private": true,
  "type": "module",
  "description": "Sunbeam, the AstraFoundry design system: the web package (@astrafoundry/design) and the MyGo package (github.com/AstraFoundry/design/packages/mygo).",
  "license": "MIT",
  "scripts": {
    "check": "pnpm --filter @astrafoundry/design check && pnpm run mygo:check",
    "build": "pnpm --filter @astrafoundry/design build",
    "typecheck": "pnpm --filter @astrafoundry/design typecheck",
    "lint": "pnpm --filter @astrafoundry/design lint",
    "test": "pnpm --filter @astrafoundry/design test && pnpm run mygo:test",
    "tokens:build": "pnpm --filter @astrafoundry/design tokens:build",
    "assets:build": "pnpm --filter @astrafoundry/design assets:build",
    "mygo:check": "cd packages/mygo && gofmt -l . | (! grep .) && go vet ./... && go test ./...",
    "mygo:test": "cd packages/mygo && go test ./...",
    "mygo:gallery": "cd packages/mygo && go run ./examples/gallery"
  },
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
