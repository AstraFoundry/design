{
  "name": "@astrafoundry/design",
  "version": "0.1.0",
  "description": "Sunbeam tokens, components, and mock stages for AstraFoundry. This repository accepts community taste contributions; @astrafoundry/design is the versioned npm package.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AstraFoundry/design.git",
    "directory": "packages/web"
  },
  "bugs": {
    "url": "https://github.com/AstraFoundry/design/issues"
  },
  "homepage": "https://github.com/AstraFoundry/design/tree/main/packages/web#readme",
  "files": [
    "dist",
    "src",
    "tokens",
    "fonts",
    "styles.css",
    "assets/backdrops.json",
    "assets/source",
    "skills",
    "DESIGN.md",
    "scripts/build-backdrops.mjs",
    "docs"
  ],
  "bin": {
    "astrafoundry-backdrops": "./scripts/build-backdrops.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./ui": {
      "types": "./src/ui/index.ts",
      "import": "./src/ui/index.ts"
    },
    "./mock": {
      "types": "./src/mock/index.ts",
      "import": "./src/mock/index.ts"
    },
    "./beui/agents/agent-activity": {
      "types": "./src/beui/components/agents/agent-activity/index.tsx",
      "import": "./src/beui/components/agents/agent-activity/index.tsx"
    },
    "./beui/agents/loading-states": {
      "types": "./src/beui/components/agents/loading-states/index.ts",
      "import": "./src/beui/components/agents/loading-states/index.ts"
    },
    "./beui/motion/button": {
      "types": "./src/beui/components/motion/button/index.tsx",
      "import": "./src/beui/components/motion/button/index.tsx"
    },
    "./beui/lib/ease": {
      "types": "./src/beui/lib/ease.ts",
      "import": "./src/beui/lib/ease.ts"
    },
    "./beui/*": {
      "types": "./src/beui/components/*.tsx",
      "import": "./src/beui/components/*.tsx"
    },
    "./styles.css": "./styles.css",
    "./tokens/*": "./tokens/*",
    "./fonts/*": "./fonts/*",
    "./assets/backdrops.json": "./assets/backdrops.json",
    "./skills/*": "./skills/*",
    "./DESIGN.md": "./DESIGN.md",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./ui": {
        "types": "./dist/ui/index.d.ts",
        "import": "./dist/ui/index.js"
      },
      "./mock": {
        "types": "./dist/mock/index.d.ts",
        "import": "./dist/mock/index.js"
      },
      "./beui/agents/agent-activity": {
        "types": "./dist/beui/components/agents/agent-activity/index.d.ts",
        "import": "./dist/beui/components/agents/agent-activity/index.js"
      },
      "./beui/agents/loading-states": {
        "types": "./dist/beui/components/agents/loading-states/index.d.ts",
        "import": "./dist/beui/components/agents/loading-states/index.js"
      },
      "./beui/motion/button": {
        "types": "./dist/beui/components/motion/button/index.d.ts",
        "import": "./dist/beui/components/motion/button/index.js"
      },
      "./beui/lib/ease": {
        "types": "./dist/beui/lib/ease.d.ts",
        "import": "./dist/beui/lib/ease.js"
      },
      "./beui/*": {
        "types": "./dist/beui/components/*.d.ts",
        "import": "./dist/beui/components/*.js"
      },
      "./styles.css": "./styles.css",
      "./tokens/*": "./tokens/*",
      "./fonts/*": "./fonts/*",
      "./assets/backdrops.json": "./assets/backdrops.json",
      "./skills/*": "./skills/*",
      "./DESIGN.md": "./DESIGN.md",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter taste-example typecheck",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "lint": "eslint . --max-warnings=0",
    "test": "node scripts/tokens.mjs --check && vitest run",
    "tokens:build": "node scripts/tokens.mjs",
    "assets:build": "node scripts/build-backdrops.mjs --update-data"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "motion": "^13.4.2",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": ">=0.34.0",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "next-themes": {
      "optional": true
    },
    "sharp": {
      "optional": true
    },
    "shiki": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@google/design.md": "0.4.0",
    "@tailwindcss/node": "^4.3.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^27.0.0",
    "motion": "^13.4.2",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.34.4",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  }
}
