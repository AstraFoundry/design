{
  "$description": "Sunbeam token values. Single source for tokens/sunbeam.css, the skill's token tables and DESIGN.md (pnpm tokens:build). Colors are CSS color/shadow values; var(--name) refers to another token in this file. typography, rounded, spacing and components follow the DESIGN.md token schema; components are written for light mode and their dark twins are derived.",
  "scales": {
    "yellow-100": "hsl(48 100% 88%)",
    "yellow-300": "hsl(48 100% 64%)",
    "yellow-500": "hsl(48 100% 50%)",
    "yellow-700": "hsl(45 100% 27%)",
    "ink-50": "hsl(40 30% 97%)",
    "ink-100": "hsl(38 22% 92%)",
    "ink-200": "hsl(36 16% 85%)",
    "ink-300": "hsl(34 12% 72%)",
    "ink-400": "hsl(32 8% 56%)",
    "ink-500": "hsl(30 6% 40%)",
    "ink-600": "hsl(28 8% 30%)",
    "ink-700": "hsl(26 10% 20%)",
    "ink-800": "hsl(24 12% 12%)",
    "ink-900": "hsl(22 14% 7%)"
  },
  "substrate": {
    "substrate": "hsl(40 17.6% 3.3%)",
    "substrate-surface": "hsl(40 15.8% 7.5%)",
    "substrate-raised": "hsl(40 17% 10.4%)",
    "substrate-line": "hsl(37 17% 15.1%)",
    "substrate-edge": "hsl(38 16% 19.6%)",
    "substrate-hi": "var(--ink-50)",
    "substrate-ink": "var(--ink-200)",
    "substrate-muted": "var(--ink-400)",
    "substrate-focus": "hsl(0 0% 100%)",
    "substrate-focus-ink": "var(--ink-900)",
    "substrate-tint": "hsl(28 34% 78% / 0.46)",
    "substrate-tint-ink": "var(--ink-50)",
    "substrate-tint-muted": "hsl(36 30% 94% / 0.72)"
  },
  "light": {
    "background": "var(--ink-50)",
    "foreground": "var(--ink-900)",
    "card": "hsl(0 0% 100%)",
    "card-foreground": "var(--ink-900)",
    "popover": "hsl(0 0% 100%)",
    "popover-foreground": "var(--ink-900)",
    "primary": "var(--yellow-500)",
    "primary-foreground": "var(--ink-900)",
    "secondary": "var(--ink-100)",
    "secondary-foreground": "var(--ink-700)",
    "muted": "var(--ink-100)",
    "muted-foreground": "var(--ink-500)",
    "accent": "var(--yellow-100)",
    "accent-foreground": "var(--yellow-700)",
    "border": "var(--ink-200)",
    "input": "var(--ink-200)",
    "ring": "var(--yellow-500)",
    "faint": "var(--ink-400)",
    "success": "hsl(150 67% 37%)",
    "danger": "hsl(10 76% 50%)",
    "info": "hsl(225 70% 53%)",
    "canvas": "hsl(40 24% 95%)",
    "canvas-dot": "hsl(34 12% 78%)",
    "scrim": "hsl(22 14% 7%)",
    "image-outline": "rgb(0 0 0 / 0.1)",
    "shadow-1": "0 1px 0 rgb(20 18 14 / 0.04), 0 1px 2px rgb(20 18 14 / 0.06)",
    "shadow-2": "0 1px 0 rgb(20 18 14 / 0.04), 0 4px 10px -2px rgb(20 18 14 / 0.08)",
    "shadow-3": "0 2px 0 rgb(20 18 14 / 0.04), 0 10px 24px -4px rgb(20 18 14 / 0.1)",
    "shadow-4": "0 4px 0 rgb(20 18 14 / 0.04), 0 20px 48px -8px rgb(20 18 14 / 0.14)",
    "shadow-5": "0 8px 0 rgb(20 18 14 / 0.04), 0 32px 64px -12px rgb(20 18 14 / 0.2)",
    "art-cell": "var(--card)",
    "art-cell-hover": "hsl(40 20% 97.5%)",
    "art-panel": "hsl(40 24% 97.6%)",
    "art-panel-hover": "hsl(40 16% 95.6%)",
    "art-ring": "rgb(20 18 14 / 0.07)",
    "art-ring-hover": "rgb(20 18 14 / 0.09)",
    "art-texture": "rgb(20 18 14 / 0.055)",
    "art-bar": "var(--ink-100)",
    "art-bar-strong": "var(--ink-200)",
    "art-data": "var(--ink-300)",
    "art-window": "hsl(0 0% 100%)",
    "art-window-ring": "rgb(20 18 14 / 0.06)",
    "art-window-shadow": "0 8px 20px -10px rgb(20 18 14 / 0.25)",
    "art-strip": "hsl(38 20% 94%)",
    "art-field": "hsl(40 22% 95.5%)",
    "art-accent": "var(--yellow-500)",
    "art-accent-ink": "var(--yellow-700)",
    "art-ink": "var(--ink-900)",
    "art-glyph": "var(--ink-500)",
    "figure-shade": "0.16",
    "figure-well": "0.1",
    "figure-halo": "0.08",
    "figure-lift": "0",
    "figure-soften": "0"
  },
  "dark": {
    "background": "hsl(22 18% 3%)",
    "foreground": "var(--ink-50)",
    "card": "var(--ink-800)",
    "card-foreground": "var(--ink-50)",
    "popover": "var(--ink-800)",
    "popover-foreground": "var(--ink-50)",
    "secondary": "var(--ink-700)",
    "secondary-foreground": "var(--ink-50)",
    "muted": "var(--ink-700)",
    "muted-foreground": "var(--ink-300)",
    "accent": "hsl(45 70% 13%)",
    "accent-foreground": "var(--yellow-300)",
    "border": "hsl(26 10% 18%)",
    "input": "hsl(26 10% 18%)",
    "faint": "var(--ink-400)",
    "canvas": "hsl(24 14% 6%)",
    "canvas-dot": "hsl(26 10% 20%)",
    "image-outline": "rgb(255 255 255 / 0.1)",
    "shadow-1": "0 1px 0 rgb(0 0 0 / 0.3), 0 1px 2px rgb(0 0 0 / 0.4)",
    "shadow-2": "0 1px 0 rgb(0 0 0 / 0.3), 0 4px 10px -2px rgb(0 0 0 / 0.5)",
    "shadow-3": "0 2px 0 rgb(0 0 0 / 0.3), 0 10px 24px -4px rgb(0 0 0 / 0.55)",
    "shadow-4": "0 4px 0 rgb(0 0 0 / 0.3), 0 20px 48px -8px rgb(0 0 0 / 0.6)",
    "shadow-5": "0 8px 0 rgb(0 0 0 / 0.3), 0 32px 64px -12px rgb(0 0 0 / 0.7)",
    "art-cell": "hsl(24 10% 8.5%)",
    "art-cell-hover": "hsl(24 10% 10%)",
    "art-panel": "hsl(24 10% 11%)",
    "art-panel-hover": "hsl(24 10% 12.5%)",
    "art-ring": "rgb(255 255 255 / 0.06)",
    "art-ring-hover": "rgb(255 255 255 / 0.08)",
    "art-texture": "rgb(255 255 255 / 0.04)",
    "art-bar": "hsl(26 8% 18%)",
    "art-bar-strong": "hsl(26 8% 24%)",
    "art-data": "hsl(30 6% 36%)",
    "art-window": "hsl(24 9% 15%)",
    "art-window-ring": "rgb(255 255 255 / 0.06)",
    "art-window-shadow": "0 8px 20px -10px rgb(0 0 0 / 0.6)",
    "art-strip": "hsl(24 10% 10.5%)",
    "art-field": "hsl(24 9% 18%)",
    "art-accent": "var(--yellow-500)",
    "art-accent-ink": "var(--yellow-300)",
    "art-ink": "var(--ink-50)",
    "art-glyph": "var(--ink-300)",
    "figure-shade": "0.5",
    "figure-well": "0.5",
    "figure-halo": "0.22",
    "figure-lift": "0.05",
    "figure-soften": "0.35"
  },
  "typography": {
    "headline-display": {
      "fontFamily": "Fraunces, Iowan Old Style, serif",
      "fontSize": "96px",
      "fontWeight": 400,
      "lineHeight": 0.98,
      "letterSpacing": "-0.03em"
    },
    "headline-lg": {
      "fontFamily": "Fraunces, Iowan Old Style, serif",
      "fontSize": "48px",
      "fontWeight": 400,
      "lineHeight": 1.05,
      "letterSpacing": "-0.02em"
    },
    "headline-md": {
      "fontFamily": "IBM Plex Sans, system-ui, sans-serif",
      "fontSize": "24px",
      "fontWeight": 500,
      "lineHeight": 1.3,
      "letterSpacing": "-0.01em"
    },
    "body-lg": {
      "fontFamily": "IBM Plex Sans, system-ui, sans-serif",
      "fontSize": "18px",
      "fontWeight": 400,
      "lineHeight": 1.6
    },
    "body-md": {
      "fontFamily": "IBM Plex Sans, system-ui, sans-serif",
      "fontSize": "16px",
      "fontWeight": 400,
      "lineHeight": 1.6
    },
    "body-sm": {
      "fontFamily": "IBM Plex Sans, system-ui, sans-serif",
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "label-md": {
      "fontFamily": "IBM Plex Sans, system-ui, sans-serif",
      "fontSize": "14px",
      "fontWeight": 500,
      "lineHeight": 1.5
    },
    "caption": {
      "fontFamily": "IBM Plex Sans, system-ui, sans-serif",
      "fontSize": "13px",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "code-md": {
      "fontFamily": "JetBrains Mono, ui-monospace, monospace",
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.6
    }
  },
  "rounded": {
    "none": "0px",
    "xs": "2px",
    "sm": "4px",
    "md": "6px",
    "lg": "10px",
    "xl": "14px",
    "2xl": "18px",
    "chip": "20px",
    "focus": "22px",
    "3xl": "24px",
    "tile": "28px",
    "stage": "40px",
    "full": "9999px"
  },
  "spacing": {
    "unit": "4px",
    "hairline": "1px",
    "tile-inset": "8px",
    "card-inset-sm": "24px",
    "card-inset-md": "40px",
    "card-inset-lg": "56px"
  },
  "components": {
    "page": {
      "backgroundColor": "{colors.background}",
      "textColor": "{colors.foreground}",
      "typography": "{typography.body-md}"
    },
    "caption": {
      "backgroundColor": "{colors.background}",
      "textColor": "{colors.muted-foreground}",
      "typography": "{typography.caption}"
    },
    "card": {
      "backgroundColor": "{colors.card}",
      "textColor": "{colors.card-foreground}",
      "rounded": "{rounded.3xl}",
      "padding": "24px"
    },
    "popover": {
      "backgroundColor": "{colors.popover}",
      "textColor": "{colors.popover-foreground}",
      "rounded": "{rounded.xl}",
      "padding": "8px"
    },
    "button-primary": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.primary-foreground}",
      "typography": "{typography.label-md}",
      "rounded": "{rounded.full}",
      "padding": "0 20px",
      "height": "40px"
    },
    "button-secondary": {
      "backgroundColor": "{colors.secondary}",
      "textColor": "{colors.secondary-foreground}",
      "typography": "{typography.label-md}",
      "rounded": "{rounded.full}",
      "padding": "0 20px",
      "height": "40px"
    },
    "chip-accent": {
      "backgroundColor": "{colors.accent}",
      "textColor": "{colors.accent-foreground}",
      "typography": "{typography.caption}",
      "rounded": "{rounded.full}",
      "padding": "2px 10px"
    },
    "well": {
      "backgroundColor": "{colors.muted}",
      "textColor": "{colors.muted-foreground}",
      "typography": "{typography.code-md}",
      "rounded": "{rounded.md}",
      "padding": "2px 6px"
    },
    "text-field": {
      "backgroundColor": "{colors.card}",
      "textColor": "{colors.foreground}",
      "typography": "{typography.body-sm}",
      "rounded": "{rounded.lg}",
      "height": "40px",
      "padding": "0 12px"
    },
    "text-field-border": {
      "backgroundColor": "{colors.input}",
      "size": "1px"
    },
    "divider": {
      "backgroundColor": "{colors.border}",
      "height": "1px"
    },
    "focus-ring": {
      "backgroundColor": "{colors.ring}",
      "size": "2px"
    },
    "figure-line": {
      "backgroundColor": "{colors.faint}",
      "size": "1px"
    },
    "status-success": {
      "textColor": "{colors.success}",
      "size": "14px"
    },
    "status-danger": {
      "textColor": "{colors.danger}",
      "size": "14px"
    },
    "status-info": {
      "textColor": "{colors.info}",
      "size": "14px"
    },
    "canvas": {
      "backgroundColor": "{colors.canvas}",
      "textColor": "{colors.foreground}"
    },
    "canvas-dot": {
      "backgroundColor": "{colors.canvas-dot}",
      "size": "2px"
    },
    "photo-scrim": {
      "backgroundColor": "{colors.scrim}"
    },
    "image-outline": {
      "backgroundColor": "{colors.image-outline}",
      "size": "1px"
    },
    "backdrop-card": {
      "backgroundColor": "{colors.substrate}",
      "textColor": "{colors.substrate-hi}",
      "typography": "{typography.headline-md}",
      "rounded": "{rounded.stage}",
      "padding": "{spacing.card-inset-lg}"
    },
    "backdrop-focus": {
      "backgroundColor": "{colors.substrate-focus}",
      "textColor": "{colors.substrate-focus-ink}",
      "typography": "{typography.body-lg}",
      "rounded": "{rounded.focus}",
      "padding": "20px 24px"
    },
    "backdrop-chip": {
      "backgroundColor": "{colors.substrate-tint}",
      "rounded": "{rounded.chip}",
      "padding": "16px 20px"
    },
    "backdrop-chip-label": {
      "textColor": "{colors.substrate-tint-ink}",
      "typography": "{typography.body-lg}"
    },
    "backdrop-caption": {
      "textColor": "{colors.substrate-tint-muted}",
      "typography": "{typography.headline-md}"
    },
    "stage-panel": {
      "backgroundColor": "{colors.substrate-surface}",
      "textColor": "{colors.substrate-ink}",
      "typography": "{typography.body-sm}",
      "rounded": "{rounded.2xl}"
    },
    "stage-raised": {
      "backgroundColor": "{colors.substrate-raised}",
      "textColor": "{colors.substrate-muted}",
      "typography": "{typography.caption}",
      "rounded": "{rounded.xl}"
    },
    "stage-line": {
      "backgroundColor": "{colors.substrate-line}",
      "height": "1px"
    },
    "stage-edge": {
      "backgroundColor": "{colors.substrate-edge}",
      "size": "1px"
    }
  }
}
